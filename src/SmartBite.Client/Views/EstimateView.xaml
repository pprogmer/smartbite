<UserControl
  x:Class="SmartBite.Client.Views.EstimateView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:SmartBite.Client.Views"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="28,24">
      <views:ErrorBanner Margin="0,0,0,16" />
      <TextBlock Text="Оцінити страву" Style="{StaticResource PageTitle}" />

      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Input -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top">
          <StackPanel>
            <!-- Photo / Text switch -->
            <Border
              Background="{StaticResource HeaderBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="2"
            >
              <UniformGrid Columns="2">
                <RadioButton
                  Content="Фото"
                  Style="{StaticResource SegmentButton}"
                  IsChecked="{Binding IsPhoto}"
                  AutomationProperties.AutomationId="ModePhoto"
                />
                <RadioButton
                  Content="Текст"
                  Style="{StaticResource SegmentButton}"
                  IsChecked="{Binding IsText}"
                  AutomationProperties.AutomationId="ModeText"
                />
              </UniformGrid>
            </Border>

            <!-- Text -->
            <StackPanel
              Margin="0,16,0,0"
              Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
            >
              <TextBlock Text="Склад страви" Style="{StaticResource FieldLabel}" />
              <TextBox
                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                Height="160"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MaxLength="1000"
                VerticalContentAlignment="Top"
                AutomationProperties.AutomationId="EstimateText"
              />
              <DockPanel Margin="0,8,0,0">
                <TextBlock
                  DockPanel.Dock="Right"
                  Text="{Binding TextCounter}"
                  FontSize="12"
                  Style="{StaticResource Muted}"
                />
                <TextBlock Text="До 1000 символів" FontSize="12" Style="{StaticResource Muted}" />
              </DockPanel>
            </StackPanel>

            <!-- Photo -->
            <StackPanel
              Margin="0,16,0,0"
              Visibility="{Binding IsPhoto, Converter={StaticResource BoolToVisibility}}"
            >
              <Grid Height="200">
                <Border
                  x:Name="DropZone"
                  BorderBrush="{StaticResource InputBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Background="#FAF8F4"
                  AllowDrop="True"
                  Drop="DropZone_Drop"
                  Visibility="{Binding NoPhoto, Converter={StaticResource BoolToVisibility}}"
                >
                  <TextBlock
                    Text="Перетягніть фото сюди"
                    Style="{StaticResource Muted}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                  />
                </Border>
                <Border
                  CornerRadius="6"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  Background="{StaticResource HeaderBrush}"
                  Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}"
                >
                  <Image Source="{Binding PhotoPath}" Stretch="Uniform" Margin="4" />
                </Border>
              </Grid>
              <DockPanel
                Margin="0,8,0,0"
                Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}"
              >
                <Button
                  DockPanel.Dock="Right"
                  Content="✕"
                  Style="{StaticResource IconButton}"
                  Command="{Binding RemovePhotoCommand}"
                  ToolTip="Прибрати фото"
                />
                <TextBlock
                  Text="{Binding PhotoInfo}"
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                />
              </DockPanel>
              <TextBlock
                Text="{Binding PhotoError}"
                Foreground="{StaticResource DangerBrush}"
                FontSize="12"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                Visibility="{Binding HasPhotoError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="PhotoError"
              />
              <TextBlock
                Text="Формати: JPEG, PNG. Розмір до 5 МБ."
                FontSize="12"
                Style="{StaticResource Muted}"
                Margin="0,8,0,0"
              />
              <TextBlock
                Text="Фотографія не зберігається після аналізу."
                FontSize="12"
                Style="{StaticResource Muted}"
                Margin="0,2,0,0"
              />
              <Button
                Content="Вибрати файл"
                Command="{Binding PickPhotoCommand}"
                HorizontalAlignment="Left"
                Margin="0,16,0,0"
                AutomationProperties.AutomationId="PickPhoto"
              />
            </StackPanel>

            <Button
              Content="✦ Оцінити"
              Command="{Binding EstimateCommand}"
              Style="{StaticResource PrimaryButton}"
              HorizontalAlignment="Left"
              Margin="0,16,0,0"
              AutomationProperties.AutomationId="Estimate"
            />
          </StackPanel>
        </Border>

        <!-- Result area: placeholder, loading or result -->
        <Grid Grid.Column="2">
          <Border
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="32"
            MinHeight="280"
            VerticalAlignment="Top"
            Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}"
          >
            <TextBlock
              Text="Результат оцінки з'явиться тут"
              Style="{StaticResource Muted}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            />
          </Border>

          <Border
            Style="{StaticResource Card}"
            Padding="32"
            MinHeight="280"
            VerticalAlignment="Top"
            Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}"
          >
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <ProgressBar
                IsIndeterminate="True"
                Width="280"
                Height="4"
                Foreground="{StaticResource GreenBrush}"
              />
              <TextBlock Text="{Binding LoadingText}" Margin="0,16" HorizontalAlignment="Center" />
              <Button
                Content="Скасувати"
                Command="{Binding CancelCommand}"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="CancelEstimate"
              />
            </StackPanel>
          </Border>

          <Border
            Style="{StaticResource Card}"
            VerticalAlignment="Top"
            Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.AutomationId="EstimateResult"
          >
            <StackPanel>
              <WrapPanel Margin="20,20,20,16">
                <TextBlock
                  Text="{Binding DishName}"
                  Style="{StaticResource SectionTitle}"
                  VerticalAlignment="Center"
                  TextWrapping="Wrap"
                  AutomationProperties.AutomationId="DishName"
                />
                <Border Style="{StaticResource Badge}" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="✦ Орієнтовна оцінка" FontSize="12" />
                </Border>
              </WrapPanel>

              <!-- Table: the mass of a component can be changed. -->
              <Grid Background="{StaticResource HeaderBrush}" Height="36">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Text="Компонент"
                  Style="{StaticResource TableHeader}"
                  VerticalAlignment="Center"
                  Margin="20,0,0,0"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="Маса, г"
                  Style="{StaticResource TableHeader}"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                  Margin="0,0,10,0"
                />
                <TextBlock
                  Grid.Column="2"
                  Text="Ккал"
                  Style="{StaticResource TableHeader}"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                />
                <TextBlock
                  Grid.Column="3"
                  Text="Б"
                  Foreground="{StaticResource ProteinBrush}"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                />
                <TextBlock
                  Grid.Column="4"
                  Text="Ж"
                  Foreground="{StaticResource FatBrush}"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                />
                <TextBlock
                  Grid.Column="5"
                  Text="В"
                  Foreground="{StaticResource CarbsBrush}"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                />
              </Grid>
              <ItemsControl
                ItemsSource="{Binding Components}"
                AutomationProperties.AutomationId="Components"
              >
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid MinHeight="44" Margin="0,0,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="48" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        Grid.Column="0"
                        Text="{Binding Name}"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0"
                        TextWrapping="Wrap"
                      />
                      <TextBox
                        Grid.Column="1"
                        Text="{Binding Grams}"
                        HorizontalContentAlignment="Right"
                        MinHeight="30"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Grams"
                      />
                      <TextBlock
                        Grid.Column="2"
                        Text="{Binding Calories}"
                        VerticalAlignment="Center"
                        TextAlignment="Right"
                      />
                      <TextBlock
                        Grid.Column="3"
                        Text="{Binding Protein}"
                        VerticalAlignment="Center"
                        TextAlignment="Right"
                      />
                      <TextBlock
                        Grid.Column="4"
                        Text="{Binding Fat}"
                        VerticalAlignment="Center"
                        TextAlignment="Right"
                      />
                      <TextBlock
                        Grid.Column="5"
                        Text="{Binding Carbs}"
                        VerticalAlignment="Center"
                        TextAlignment="Right"
                      />
                      <Button
                        Grid.Column="6"
                        Content="🗑"
                        Style="{StaticResource IconButton}"
                        ToolTip="Прибрати компонент"
                        Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                      />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid
                Background="{StaticResource HeaderBrush}"
                Height="44"
                TextElement.FontWeight="SemiBold"
              >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Text="Разом"
                  VerticalAlignment="Center"
                  Margin="20,0,0,0"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding TotalGrams}"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                  Margin="0,0,10,0"
                />
                <TextBlock
                  Grid.Column="2"
                  Text="{Binding TotalCalories}"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                  AutomationProperties.AutomationId="TotalCalories"
                />
                <TextBlock
                  Grid.Column="3"
                  Text="{Binding TotalProtein}"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                />
                <TextBlock
                  Grid.Column="4"
                  Text="{Binding TotalFat}"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                />
                <TextBlock
                  Grid.Column="5"
                  Text="{Binding TotalCarbs}"
                  VerticalAlignment="Center"
                  TextAlignment="Right"
                />
              </Grid>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16">
                <Button Content="Скинути зміни" Command="{Binding ResetCommand}" />
                <Button
                  Content="+ Додати до щоденника"
                  Command="{Binding AddToDiaryCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Margin="8,0,0,0"
                  AutomationProperties.AutomationId="AddEstimateToDiary"
                />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
