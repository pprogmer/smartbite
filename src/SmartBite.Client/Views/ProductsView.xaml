<UserControl
  x:Class="SmartBite.Client.Views.ProductsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:SmartBite.Client.Views"
  xmlns:vm="clr-namespace:SmartBite.Client.ViewModels"
>
  <UserControl.Resources>
    <Style x:Key="RowItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="12,0,16,0" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Box"
              Background="Transparent"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#0A000000" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#F1EEE7" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Мої продукти" Style="{StaticResource PageTitle}" />

    <views:ErrorBanner Grid.Row="1" Margin="0,16,0,0" />

    <!-- Search, filter, add -->
    <DockPanel Grid.Row="2" Margin="0,16,0,16">
      <Button
        DockPanel.Dock="Right"
        Content="+ Додати"
        Command="{Binding NewCommand}"
        AutomationProperties.AutomationId="NewProduct"
      />
      <Grid DockPanel.Dock="Left" Width="280">
        <TextBox
          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
          AutomationProperties.AutomationId="Search"
        />
        <TextBlock
          Text="Пошук продуктів"
          Style="{StaticResource Muted}"
          Foreground="#767065"
          IsHitTestVisible="False"
          VerticalAlignment="Center"
          Margin="12,0,0,0"
          Visibility="{Binding SearchText, Converter={StaticResource InverseVisibility}}"
        />
      </Grid>
      <Button
        DockPanel.Dock="Left"
        Content="✕"
        Style="{StaticResource IconButton}"
        Command="{Binding ClearSearchCommand}"
        Margin="4,0,0,0"
        ToolTip="Очистити пошук"
      />
      <TextBlock
        DockPanel.Dock="Left"
        Text="Категорія"
        Style="{StaticResource Muted}"
        VerticalAlignment="Center"
        Margin="16,0,8,0"
      />
      <ComboBox
        DockPanel.Dock="Left"
        Width="220"
        ItemsSource="{Binding Filters}"
        DisplayMemberPath="Label"
        SelectedItem="{Binding Filter}"
        HorizontalAlignment="Left"
        AutomationProperties.AutomationId="FilterCategory"
      />
    </DockPanel>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- List -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border
            Grid.Row="0"
            Background="{StaticResource HeaderBrush}"
            CornerRadius="7,7,0,0"
            Height="36"
            Padding="12,0,16,0"
          >
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="1"
                Text="Назва"
                Style="{StaticResource TableHeader}"
                VerticalAlignment="Center"
              />
              <TextBlock
                Grid.Column="2"
                Text="Кількість"
                Style="{StaticResource TableHeader}"
                VerticalAlignment="Center"
                TextAlignment="Right"
              />
              <TextBlock
                Grid.Column="4"
                Text="Категорія"
                Style="{StaticResource TableHeader}"
                VerticalAlignment="Center"
              />
            </Grid>
          </Border>

          <ListBox
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding Selected}"
            BorderThickness="0"
            Background="Transparent"
            ItemContainerStyle="{StaticResource RowItem}"
            AutomationProperties.AutomationId="ProductList"
          >
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="200" />
                  </Grid.ColumnDefinitions>
                  <CheckBox
                    Grid.Column="0"
                    IsChecked="{Binding IsChecked}"
                    HorizontalAlignment="Center"
                    MinWidth="0"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <TextBlock Grid.Column="2" Text="{Binding Quantity}" TextAlignment="Right" />
                  <TextBlock
                    Grid.Column="4"
                    Text="{Binding Category}"
                    Style="{StaticResource Muted}"
                    TextTrimming="CharacterEllipsis"
                  />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty list -->
          <StackPanel
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
          >
            <TextBlock
              Text="У вас ще немає продуктів. Натисніть «Додати», щоб створити перший"
              Style="{StaticResource Muted}"
              TextAlignment="Center"
              TextWrapping="Wrap"
              MaxWidth="360"
              Margin="0,0,0,16"
            />
            <Button
              Content="+ Додати"
              Command="{Binding NewCommand}"
              Style="{StaticResource PrimaryButton}"
              HorizontalAlignment="Center"
            />
          </StackPanel>

          <Border
            Grid.Row="2"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12"
          >
            <DockPanel>
              <Button
                DockPanel.Dock="Right"
                Content="Приготувати з вибраних"
                Command="{Binding CookCommand}"
                Style="{StaticResource PrimaryButton}"
                AutomationProperties.AutomationId="Cook"
              />
              <TextBlock
                DockPanel.Dock="Left"
                Text="{Binding ChosenText}"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ChosenCount"
              />
              <TextBlock
                Text="Для рецепта можна вибрати від 1 до 15 продуктів"
                FontSize="12"
                Style="{StaticResource Muted}"
                VerticalAlignment="Center"
                Margin="16,0"
                TextTrimming="CharacterEllipsis"
              />
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Edit panel -->
      <Border
        Grid.Column="2"
        Style="{StaticResource Card}"
        Width="320"
        Padding="20"
        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
      >
        <StackPanel>
          <TextBlock Text="Продукт" Style="{StaticResource SectionTitle}" />

          <TextBlock Text="Назва" Style="{StaticResource FieldLabel}" Margin="0,16,0,8" />
          <TextBox Text="{Binding Name}" AutomationProperties.AutomationId="ProductName" />

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Кількість" Style="{StaticResource FieldLabel}" />
              <TextBox
                Text="{Binding Quantity}"
                HorizontalContentAlignment="Right"
                AutomationProperties.AutomationId="ProductQuantity"
              />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Одиниця" Style="{StaticResource FieldLabel}" />
              <ComboBox
                ItemsSource="{x:Static vm:Labels.Units}"
                DisplayMemberPath="Label"
                SelectedValuePath="Value"
                SelectedValue="{Binding Unit}"
                AutomationProperties.AutomationId="ProductUnit"
              />
            </StackPanel>
          </Grid>

          <TextBlock Text="Категорія" Style="{StaticResource FieldLabel}" Margin="0,16,0,8" />
          <ComboBox
            ItemsSource="{x:Static vm:Labels.Categories}"
            DisplayMemberPath="Label"
            SelectedValuePath="Value"
            SelectedValue="{Binding Category}"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="ProductCategory"
          />

          <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
              Grid.Column="0"
              Content="Видалити"
              Command="{Binding DeleteCommand}"
              HorizontalAlignment="Stretch"
              Foreground="{StaticResource DangerBrush}"
              AutomationProperties.AutomationId="DeleteProduct"
              Visibility="{Binding IsNew, Converter={StaticResource InverseVisibility}}"
            />
            <Button
              Grid.Column="2"
              Content="Зберегти"
              Command="{Binding SaveCommand}"
              Style="{StaticResource PrimaryButton}"
              HorizontalAlignment="Stretch"
              AutomationProperties.AutomationId="SaveProduct"
            />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
