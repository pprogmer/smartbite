<UserControl
  x:Class="SmartBite.Client.Views.StatsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:SmartBite.Client.Views"
>
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button
          Content="‹"
          FontSize="20"
          Command="{Binding PreviousCommand}"
          Width="32"
          Padding="0"
          ToolTip="Попередній тиждень"
          AutomationProperties.AutomationId="PrevWeek"
        />
        <TextBlock
          Text="{Binding Range}"
          VerticalAlignment="Center"
          Width="150"
          TextAlignment="Center"
          AutomationProperties.AutomationId="WeekRange"
        />
        <Button
          Content="›"
          FontSize="20"
          Command="{Binding NextCommand}"
          Width="32"
          Padding="0"
          ToolTip="Наступний тиждень"
          AutomationProperties.AutomationId="NextWeek"
        />
      </StackPanel>
      <TextBlock Text="Статистика за тиждень" Style="{StaticResource PageTitle}" />
    </DockPanel>

    <views:ErrorBanner Grid.Row="1" Margin="0,16,0,0" />

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,20,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and legend -->
        <DockPanel Margin="24,20,24,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Border
              Width="10"
              Height="10"
              CornerRadius="2"
              Background="{StaticResource GreenBrush}"
            />
            <TextBlock Text="у межах норми" Style="{StaticResource Muted}" Margin="6,0,20,0" />
            <Border
              Width="10"
              Height="10"
              CornerRadius="2"
              Background="{StaticResource DangerBrush}"
            />
            <TextBlock Text="перевищення" Style="{StaticResource Muted}" Margin="6,0,20,0" />
            <Line
              X2="16"
              Stroke="{StaticResource MutedBrush}"
              StrokeThickness="2"
              StrokeDashArray="4 2"
              VerticalAlignment="Center"
            />
            <TextBlock Text="норма" Style="{StaticResource Muted}" Margin="6,0,0,0" />
          </StackPanel>
          <TextBlock Text="Калорії за день, ккал" Style="{StaticResource SectionTitle}" />
        </DockPanel>

        <!-- Chart: seven columns; the norm line is drawn over them. -->
        <Grid Grid.Row="1" Margin="24,24,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <ItemsControl ItemsSource="{Binding Bars}" AutomationProperties.AutomationId="Bars">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Width="56">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="{Binding Empty}" />
                      <RowDefinition Height="{Binding Filled}" MinHeight="2" />
                    </Grid.RowDefinitions>
                    <TextBlock
                      Grid.Row="0"
                      Text="{Binding Value}"
                      FontSize="12"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,4"
                    />
                    <Border Grid.Row="1" Background="{Binding Brush}" CornerRadius="4,4,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The norm: the boundary between a gap above and a gap below. -->
            <Grid
              IsHitTestVisible="False"
              Visibility="{Binding HasNorm, Converter={StaticResource BoolToVisibility}}"
            >
              <Grid.RowDefinitions>
                <RowDefinition Height="{Binding NormEmpty}" />
                <RowDefinition Height="{Binding NormFilled}" />
              </Grid.RowDefinitions>
              <Line
                Grid.Row="1"
                X2="1"
                Stretch="Fill"
                Stroke="{StaticResource MutedBrush}"
                StrokeThickness="2"
                StrokeDashArray="4 2"
                VerticalAlignment="Top"
              />
              <TextBlock
                Grid.Row="1"
                Text="{Binding NormText}"
                FontSize="12"
                Style="{StaticResource Muted}"
                Background="{StaticResource CardBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,-18,0,0"
                Padding="4,0"
              />
            </Grid>
          </Grid>

          <ItemsControl
            Grid.Row="1"
            ItemsSource="{Binding Bars}"
            BorderBrush="#8E877B"
            BorderThickness="0,1,0,0"
          >
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock
                  Text="{Binding Day}"
                  FontSize="12"
                  HorizontalAlignment="Center"
                  Margin="0,6"
                >
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                          <Setter Property="FontWeight" Value="SemiBold" />
                          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <Border
          Grid.Row="2"
          Background="{StaticResource HeaderBrush}"
          BorderBrush="{StaticResource LineBrush}"
          BorderThickness="0,1,0,0"
          CornerRadius="0,0,7,7"
          Padding="24,16"
        >
          <TextBlock Text="{Binding Summary}" AutomationProperties.AutomationId="Summary" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
