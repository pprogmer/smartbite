<UserControl x:Class="SmartBite.Client.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="320" VerticalAlignment="Center">
        <TextBlock Text="SmartBite" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Message}" Foreground="SeaGreen" TextWrapping="Wrap" />

        <TextBlock Text="Електронна пошта" Margin="0,8,0,4" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

        <TextBlock Text="Пароль" Margin="0,8,0,4" />
        <PasswordBox PasswordChanged="Password_Changed" Padding="4" />

        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegister}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Підтвердження пароля" Margin="0,8,0,4" />
            <PasswordBox PasswordChanged="ConfirmPassword_Changed" Padding="4" />
        </StackPanel>

        <Button Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" IsDefault="True"
                Margin="0,16,0,0" Padding="8" />
        <Button Content="{Binding ToggleModeText}" Command="{Binding ToggleModeCommand}"
                Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Foreground="SeaGreen" />
    </StackPanel>
</UserControl>
