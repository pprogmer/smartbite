<UserControl
  x:Class="SmartBite.Client.Views.AuthView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:SmartBite.Client.Views"
>
  <Border
    Style="{StaticResource Card}"
    Width="400"
    VerticalAlignment="Center"
    HorizontalAlignment="Center"
    Padding="32"
  >
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource GreenBrush}">
          <TextBlock
            Text="S"
            Foreground="White"
            FontWeight="Bold"
            FontSize="22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          />
        </Border>
        <TextBlock
          Text="SmartBite"
          Style="{StaticResource PageTitle}"
          Margin="12,0,0,0"
          VerticalAlignment="Center"
        />
      </StackPanel>
      <TextBlock
        Text="Планування харчування з наявних продуктів"
        Style="{StaticResource Muted}"
        Margin="0,12,0,24"
        TextWrapping="Wrap"
      />

      <views:ErrorBanner Margin="0,0,0,24" />

      <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
        <RadioButton
          Content="Вхід"
          Style="{StaticResource TabButton}"
          IsChecked="{Binding IsLogin}"
          AutomationProperties.AutomationId="LoginTab"
        />
        <RadioButton
          Content="Реєстрація"
          Style="{StaticResource TabButton}"
          IsChecked="{Binding IsRegister}"
          AutomationProperties.AutomationId="RegisterTab"
        />
      </StackPanel>

      <StackPanel IsEnabled="{Binding IsEditable}">
        <TextBlock Text="Електронна пошта" Style="{StaticResource FieldLabel}" />
        <TextBox
          Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
          AutomationProperties.AutomationId="Email"
        />

        <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="0,16,0,8" />
        <PasswordBox
          PasswordChanged="Password_Changed"
          AutomationProperties.AutomationId="Password"
        />

        <StackPanel Visibility="{Binding IsRegister, Converter={StaticResource BoolToVisibility}}">
          <TextBlock
            Text="Підтвердження пароля"
            Style="{StaticResource FieldLabel}"
            Margin="0,16,0,8"
          />
          <PasswordBox
            PasswordChanged="ConfirmPassword_Changed"
            AutomationProperties.AutomationId="ConfirmPassword"
          />
        </StackPanel>
      </StackPanel>

      <Button
        Content="{Binding SubmitText}"
        Command="{Binding SubmitCommand}"
        IsDefault="True"
        Style="{StaticResource PrimaryButton}"
        Height="40"
        Margin="0,24,0,0"
        AutomationProperties.AutomationId="Submit"
      />
    </StackPanel>
  </Border>
</UserControl>
