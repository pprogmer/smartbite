<UserControl
  x:Class="SmartBite.Client.Views.ErrorBanner"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="Root"
>
  <!-- The message of the page's view model (Error). The page may add a "retry" command. -->
  <Border
    Background="{StaticResource DangerBgBrush}"
    BorderBrush="{StaticResource DangerBorderBrush}"
    BorderThickness="1"
    CornerRadius="4"
    Padding="12,6,6,6"
    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
    AutomationProperties.AutomationId="ErrorBanner"
  >
    <DockPanel>
      <Button
        DockPanel.Dock="Right"
        Content="✕"
        Style="{StaticResource IconButton}"
        Command="{Binding DismissErrorCommand}"
      />
      <Button
        DockPanel.Dock="Right"
        Content="Спробувати ще раз"
        Margin="0,0,8,0"
        Command="{Binding RetryCommand, ElementName=Root}"
        Visibility="{Binding RetryCommand, ElementName=Root, Converter={StaticResource RetryVisibility}}"
      />
      <TextBlock
        Text="⚠"
        Foreground="{StaticResource DangerBrush}"
        FontSize="16"
        VerticalAlignment="Center"
        Margin="0,0,10,0"
        DockPanel.Dock="Left"
      />
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>
  </Border>
</UserControl>
