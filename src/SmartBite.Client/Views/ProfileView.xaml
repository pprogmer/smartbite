<UserControl
  x:Class="SmartBite.Client.Views.ProfileView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:SmartBite.Client.Views"
  xmlns:vm="clr-namespace:SmartBite.Client.ViewModels"
  xmlns:c="clr-namespace:SmartBite.Contracts;assembly=SmartBite.Contracts"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="28,24">
      <TextBlock Text="Профіль" Style="{StaticResource PageTitle}" />
      <TextBlock
        Text="Вкажіть параметри тіла та мету — після збереження відкриються всі розділи."
        Style="{StaticResource Muted}"
        Margin="0,4,0,0"
        Visibility="{Binding IsOnboarding, Converter={StaticResource BoolToVisibility}}"
      />
      <views:ErrorBanner Margin="0,16,0,0" />

      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Parameters -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Стать" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
              <RadioButton
                Content="Чоловіча"
                Margin="0,0,24,0"
                AutomationProperties.AutomationId="SexMale"
                IsChecked="{Binding Sex, Converter={StaticResource Equals}, ConverterParameter={x:Static c:Sex.Male}}"
              />
              <RadioButton
                Content="Жіноча"
                AutomationProperties.AutomationId="SexFemale"
                IsChecked="{Binding Sex, Converter={StaticResource Equals}, ConverterParameter={x:Static c:Sex.Female}}"
              />
            </StackPanel>

            <Grid Margin="0,24,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Вік, років" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Age}" AutomationProperties.AutomationId="Age" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Зріст, см" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Height}" AutomationProperties.AutomationId="Height" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Маса тіла, кг" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Weight}" AutomationProperties.AutomationId="Weight" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Активність" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
            <ComboBox
              ItemsSource="{x:Static vm:Labels.Activities}"
              DisplayMemberPath="Label"
              SelectedValuePath="Value"
              SelectedValue="{Binding Activity}"
              MaxWidth="420"
              HorizontalAlignment="Stretch"
              AutomationProperties.AutomationId="Activity"
            />

            <TextBlock Text="Мета" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
            <StackPanel Orientation="Horizontal">
              <RadioButton
                Content="Зниження маси"
                Margin="0,0,24,0"
                AutomationProperties.AutomationId="GoalLose"
                IsChecked="{Binding Goal, Converter={StaticResource Equals}, ConverterParameter={x:Static c:Goal.Lose}}"
              />
              <RadioButton
                Content="Підтримання маси"
                Margin="0,0,24,0"
                AutomationProperties.AutomationId="GoalMaintain"
                IsChecked="{Binding Goal, Converter={StaticResource Equals}, ConverterParameter={x:Static c:Goal.Maintain}}"
              />
              <RadioButton
                Content="Набір маси"
                AutomationProperties.AutomationId="GoalGain"
                IsChecked="{Binding Goal, Converter={StaticResource Equals}, ConverterParameter={x:Static c:Goal.Gain}}"
              />
            </StackPanel>

            <Border
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0"
              Margin="0,24,0,0"
              Padding="0,20,0,0"
            >
              <StackPanel Orientation="Horizontal">
                <Button
                  Content="Зберегти"
                  Command="{Binding SaveCommand}"
                  Style="{StaticResource PrimaryButton}"
                  AutomationProperties.AutomationId="Save"
                />
                <TextBlock
                  Text="{Binding Message}"
                  Foreground="{StaticResource GreenBrush}"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0"
                />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Calculated norm -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Ваша добова норма" Style="{StaticResource SectionTitle}" />

            <StackPanel
              Margin="0,20,0,0"
              Visibility="{Binding HasNorm, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.AutomationId="Norm"
            >
              <TextBlock Text="Калорії" Style="{StaticResource Muted}" />
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  Text="{Binding Norm.Calories, StringFormat={}{0:0}}"
                  FontSize="40"
                  FontWeight="SemiBold"
                />
                <TextBlock
                  Text="ккал"
                  FontSize="20"
                  Style="{StaticResource Muted}"
                  VerticalAlignment="Bottom"
                  Margin="6,0,0,8"
                />
              </StackPanel>
              <Border
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Height="40"
                Margin="0,12,0,0"
              >
                <DockPanel>
                  <Border
                    DockPanel.Dock="Left"
                    Width="10"
                    Height="10"
                    CornerRadius="2"
                    Background="{StaticResource ProteinBrush}"
                    Margin="0,0,10,0"
                  />
                  <TextBlock
                    DockPanel.Dock="Right"
                    Text="{Binding Norm.Protein, StringFormat={}{0:0} г}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                  />
                  <TextBlock Text="Білки" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <Border
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Height="40"
              >
                <DockPanel>
                  <Border
                    DockPanel.Dock="Left"
                    Width="10"
                    Height="10"
                    CornerRadius="2"
                    Background="{StaticResource FatBrush}"
                    Margin="0,0,10,0"
                  />
                  <TextBlock
                    DockPanel.Dock="Right"
                    Text="{Binding Norm.Fat, StringFormat={}{0:0} г}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                  />
                  <TextBlock Text="Жири" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <Border
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Height="40"
              >
                <DockPanel>
                  <Border
                    DockPanel.Dock="Left"
                    Width="10"
                    Height="10"
                    CornerRadius="2"
                    Background="{StaticResource CarbsBrush}"
                    Margin="0,0,10,0"
                  />
                  <TextBlock
                    DockPanel.Dock="Right"
                    Text="{Binding Norm.Carbs, StringFormat={}{0:0} г}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                  />
                  <TextBlock Text="Вуглеводи" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <TextBlock
                Text="Розрахунок за формулою Міффліна - Сан Жеора, має довідковий характер."
                FontSize="12"
                Style="{StaticResource Muted}"
                TextWrapping="Wrap"
                Margin="0,16,0,0"
              />
            </StackPanel>

            <Border
              BorderBrush="{StaticResource InputBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="16,40"
              Margin="0,20,0,0"
              Visibility="{Binding NoNorm, Converter={StaticResource BoolToVisibility}}"
            >
              <TextBlock
                Text="Заповніть профіль, щоб розрахувати норму"
                Style="{StaticResource Muted}"
                TextAlignment="Center"
                TextWrapping="Wrap"
              />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
