<UserControl
  x:Class="SmartBite.Client.Views.RecipeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:SmartBite.Client.Views"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="28,24">
      <views:ErrorBanner RetryCommand="{Binding GenerateCommand}" Margin="0,0,0,16" />
      <Border
        Background="#FFF4DA"
        BorderBrush="#F0D08A"
        BorderThickness="1"
        CornerRadius="4"
        Padding="12,10"
        Margin="0,0,0,16"
        Visibility="{Binding NormUsedUp, Converter={StaticResource BoolToVisibility}}"
        AutomationProperties.AutomationId="NormUsedUp"
      >
        <TextBlock Text="⚠ Добову норму на сьогодні вичерпано. Рецепт не буде згенеровано." />
      </Border>
      <TextBlock Text="Рецепт" Style="{StaticResource PageTitle}" />

      <!-- Parameters -->
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
        <DockPanel>
          <Button
            DockPanel.Dock="Right"
            Content="✦ Згенерувати"
            Command="{Binding GenerateCommand}"
            Style="{StaticResource PrimaryButton}"
            Margin="24,0,0,0"
            AutomationProperties.AutomationId="Generate"
          />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="24,0,0,0">
            <TextBlock Text="Порції" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox
              Text="{Binding Servings}"
              Width="64"
              HorizontalContentAlignment="Right"
              VerticalAlignment="Center"
              AutomationProperties.AutomationId="RecipeServings"
            />
          </StackPanel>
          <StackPanel>
            <DockPanel>
              <Button
                DockPanel.Dock="Right"
                Content="Змінити вибір"
                Command="{Binding ChangeProductsCommand}"
                Margin="12,0,0,0"
              />
              <TextBlock
                Text="{Binding ProductsText}"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="RecipeProducts"
              />
            </DockPanel>
            <TextBlock
              Text="{Binding RemainingText}"
              Style="{StaticResource Muted}"
              Margin="0,6,0,0"
              AutomationProperties.AutomationId="Remaining"
            />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Before the first recipe -->
      <Border
        BorderBrush="{StaticResource InputBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="32"
        Margin="0,16,0,0"
        MinHeight="280"
        Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}"
      >
        <TextBlock
          Text="Тут з'явиться рецепт із вибраних продуктів, який вкладається в залишок норми."
          Style="{StaticResource Muted}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          MaxWidth="380"
          VerticalAlignment="Center"
        />
      </Border>

      <!-- Generating: does not block the window, can be cancelled. -->
      <Border
        Style="{StaticResource Card}"
        Padding="32"
        Margin="0,16,0,0"
        MinHeight="280"
        Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}"
      >
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <ProgressBar
            IsIndeterminate="True"
            Width="320"
            Height="4"
            Foreground="{StaticResource GreenBrush}"
          />
          <TextBlock
            Text="Добираємо рецепт... Це може тривати до хвилини"
            Margin="0,16"
            HorizontalAlignment="Center"
          />
          <Button
            Content="Скасувати"
            Command="{Binding CancelCommand}"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="CancelGenerate"
          />
        </StackPanel>
      </Border>

      <!-- Result -->
      <Border
        Style="{StaticResource Card}"
        Margin="0,16,0,0"
        Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}"
        AutomationProperties.AutomationId="RecipeResult"
      >
        <StackPanel>
          <StackPanel Margin="24,20,24,0">
            <TextBlock
              Text="{Binding RecipeName}"
              Style="{StaticResource SectionTitle}"
              TextWrapping="Wrap"
              AutomationProperties.AutomationId="RecipeName"
            />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Border Style="{StaticResource Badge}">
                <TextBlock Text="✦ Орієнтовні значення" FontSize="12" />
              </Border>
              <TextBlock
                Text="{Binding Meta}"
                Style="{StaticResource Muted}"
                VerticalAlignment="Center"
                Margin="12,0,0,0"
              />
            </StackPanel>
          </StackPanel>

          <Grid Margin="24,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280" />
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding IngredientsTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Ingredients}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="0,0,0,1"
                      Height="32"
                    >
                      <DockPanel>
                        <TextBlock
                          DockPanel.Dock="Right"
                          Text="{Binding Right}"
                          Style="{StaticResource Muted}"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Text="{Binding Left}"
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis"
                        />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Приготування" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,10">
                      <Border
                        DockPanel.Dock="Left"
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="{StaticResource GreenLightBrush}"
                        VerticalAlignment="Top"
                        Margin="0,0,12,0"
                      >
                        <TextBlock
                          Text="{Binding Left}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource GreenDarkBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                        />
                      </Border>
                      <TextBlock Text="{Binding Right}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <!-- Nutrition of one serving -->
          <Border
            Background="{StaticResource HeaderBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,14"
          >
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ProgressBar
                  Style="{StaticResource Bar}"
                  Width="120"
                  Height="6"
                  Maximum="100"
                  Value="{Binding ShareOfRemaining, Mode=OneWay}"
                  Foreground="{StaticResource GreenBrush}"
                  VerticalAlignment="Center"
                />
                <TextBlock Text="{Binding ShareText}" FontWeight="SemiBold" Margin="10,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="На 1 порцію:" />
                <TextBlock
                  Text="{Binding PerServingText}"
                  FontWeight="SemiBold"
                  Margin="8,0,16,0"
                  AutomationProperties.AutomationId="PerServing"
                />
                <TextBlock
                  Text="{Binding Protein}"
                  Foreground="{StaticResource ProteinBrush}"
                  Margin="0,0,12,0"
                />
                <TextBlock
                  Text="{Binding Fat}"
                  Foreground="{StaticResource FatBrush}"
                  Margin="0,0,12,0"
                />
                <TextBlock Text="{Binding Carbs}" Foreground="{StaticResource CarbsBrush}" />
              </StackPanel>
            </DockPanel>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
            <Button Content="✦ Згенерувати інший" Command="{Binding GenerateCommand}" />
            <Button
              Content="+ Додати до щоденника"
              Command="{Binding AddToDiaryCommand}"
              Style="{StaticResource PrimaryButton}"
              Margin="8,0,0,0"
              AutomationProperties.AutomationId="AddRecipeToDiary"
            />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
