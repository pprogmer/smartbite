<Application
  x:Class="SmartBite.Client.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:SmartBite.Client.Converters"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Windows 11 look of the standard controls; the styles below are based on it. -->
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Colors of the design (docs/desings). Macro colors (protein, fat, carbs) are in Palette.cs. -->
      <SolidColorBrush x:Key="ChromeBrush" Color="#ECE8E0" />
      <SolidColorBrush x:Key="PageBrush" Color="#F8F6F2" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="HeaderBrush" Color="#F4F1EB" />
      <SolidColorBrush x:Key="LineBrush" Color="#E4DFD5" />
      <SolidColorBrush x:Key="InputBorderBrush" Color="#D3CDC2" />
      <SolidColorBrush x:Key="DividerBrush" Color="#EEEAE3" />
      <SolidColorBrush x:Key="TextBrush" Color="#1F1D1A" />
      <SolidColorBrush x:Key="MutedBrush" Color="#5C574F" />
      <SolidColorBrush x:Key="GreenBrush" Color="#2E7D4F" />
      <SolidColorBrush x:Key="GreenDarkBrush" Color="#215C3A" />
      <SolidColorBrush x:Key="GreenLightBrush" Color="#E3F0E7" />
      <SolidColorBrush x:Key="DisabledBrush" Color="#EDEAE4" />
      <SolidColorBrush x:Key="DangerBrush" Color="#C42B25" />
      <SolidColorBrush x:Key="DangerBgBrush" Color="#FCEAE8" />
      <SolidColorBrush x:Key="DangerBorderBrush" Color="#EDB5B0" />
      <SolidColorBrush x:Key="ProteinBrush" Color="#2663AA" />
      <SolidColorBrush x:Key="FatBrush" Color="#C27C00" />
      <SolidColorBrush x:Key="CarbsBrush" Color="#C0629F" />

      <conv:EqualsConverter x:Key="Equals" />
      <conv:InverseVisibilityConverter x:Key="InverseVisibility" />
      <conv:NotNullVisibilityConverter x:Key="RetryVisibility" />
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

      <!-- Text -->
      <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      </Style>
      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="TableHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      </Style>

      <!-- Inputs -->

      <!-- Cards -->
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <!-- Buttons. The standard button is used for secondary actions; the primary one is green. -->

      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Box"
                Background="{StaticResource GreenBrush}"
                CornerRadius="4"
                Padding="{TemplateBinding Padding}"
              >
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter
                    TargetName="Box"
                    Property="Background"
                    Value="{StaticResource GreenDarkBrush}"
                  />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter
                    TargetName="Box"
                    Property="Background"
                    Value="{StaticResource DisabledBrush}"
                  />
                  <Setter Property="Foreground" Value="#A29C91" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- A small flat button with a symbol, e.g. "✕". -->
      <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Box" Background="Transparent" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="#14000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Tabs of the sign-in screen: a RadioButton with an underline. -->
      <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border
                x:Name="Box"
                BorderThickness="0,0,0,3"
                BorderBrush="Transparent"
                Height="40"
                Padding="16,0"
                Background="Transparent"
              >
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter
                    TargetName="Box"
                    Property="BorderBrush"
                    Value="{StaticResource GreenBrush}"
                  />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Segmented switch "Фото / Текст": a RadioButton that looks like a button. -->
      <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Box" Height="28" CornerRadius="4" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="White" />
                  <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A small round label, e.g. "Орієнтовні значення". -->
      <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="#EEF0E6" />
        <Setter Property="BorderBrush" Value="#D8DCC6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>

      <!-- A progress bar that is red when the norm is exceeded. -->
      <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid>
                <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                <Border x:Name="PART_Track">
                  <Border
                    x:Name="PART_Indicator"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    Background="{TemplateBinding Foreground}"
                  />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
