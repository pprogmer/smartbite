<Window
  x:Class="SmartBite.Client.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:SmartBite.Client.ViewModels"
  xmlns:views="clr-namespace:SmartBite.Client.Views"
  Title="SmartBite"
  Width="1280"
  Height="800"
  MinWidth="1024"
  MinHeight="700"
  WindowStartupLocation="CenterScreen"
  FocusVisualStyle="{x:Null}"
  Background="{StaticResource ChromeBrush}"
  Foreground="{StaticResource TextBrush}"
  FontFamily="Segoe UI Variable Text, Segoe UI"
  FontSize="14"
>
  <Window.Resources>
    <!-- Navigation: a view model is shown with the view registered here. -->
    <DataTemplate DataType="{x:Type vm:AuthViewModel}">
      <views:AuthView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TodayViewModel}">
      <views:TodayView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
      <views:ProductsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecipeViewModel}">
      <views:RecipeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EstimateViewModel}">
      <views:EstimateView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StatsViewModel}">
      <views:StatsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
      <views:ProfileView />
    </DataTemplate>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Box"
              CornerRadius="4"
              Background="Transparent"
              Margin="0,0,0,2"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#14000000" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter
                  TargetName="Box"
                  Property="Background"
                  Value="{StaticResource GreenLightBrush}"
                />
                <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#A29C91" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar: shown after sign-in. -->
    <DockPanel
      Grid.Row="0"
      Height="48"
      Margin="16,0"
      Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}"
    >
      <Button
        DockPanel.Dock="Right"
        Content="Вийти"
        Command="{Binding SignOutCommand}"
        AutomationProperties.AutomationId="SignOut"
      />
      <TextBlock
        DockPanel.Dock="Right"
        Text="{Binding Email}"
        Style="{StaticResource Muted}"
        VerticalAlignment="Center"
        Margin="0,0,16,0"
      />
      <Border
        Width="28"
        Height="28"
        CornerRadius="7"
        Background="{StaticResource GreenBrush}"
        DockPanel.Dock="Left"
      >
        <TextBlock
          Text="S"
          Foreground="White"
          FontWeight="Bold"
          FontSize="16"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
        />
      </Border>
      <TextBlock
        Text="SmartBite"
        FontSize="16"
        FontWeight="SemiBold"
        VerticalAlignment="Center"
        Margin="10,0,0,0"
      />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Side panel: disabled until the profile is saved for the first time. -->
      <ListBox
        Grid.Column="0"
        Width="220"
        Padding="12,4"
        BorderThickness="0"
        Background="Transparent"
        ItemsSource="{Binding Items}"
        SelectedItem="{Binding SelectedItem}"
        DisplayMemberPath="Title"
        ItemContainerStyle="{StaticResource NavItem}"
        IsEnabled="{Binding CanNavigate}"
        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}"
        AutomationProperties.AutomationId="Sidebar"
      />

      <Border
        Grid.Column="1"
        Background="{StaticResource PageBrush}"
        BorderBrush="{StaticResource LineBrush}"
        BorderThickness="1,1,0,0"
        CornerRadius="8,0,0,0"
      >
        <ContentControl Content="{Binding Current}" />
      </Border>
    </Grid>
  </Grid>
</Window>
